{
  "name": "build-empire",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @build-empire/api & npm run dev -w @build-empire/web",
    "dev:api": "npm run dev -w @build-empire/api",
    "dev:web": "npm run dev -w @build-empire/web",
    "build": "npm run build -ws",
    "test": "npm run test -w @build-empire/api",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:config": "docker compose config",
    "docker:up:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build",
    "docker:down:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml down"
  }
}